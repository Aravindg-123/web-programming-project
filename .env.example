# ─── Fisheries Dashboard — Environment Variables ───────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── data.gov.in OGD API ───────────────────────────────────────
# Free key — register at https://data.gov.in → Dashboard → My Account → Generate Key
# Used for: DS1 (fish production KPIs), DS8 (state-wise production)
DATAGOVIN_API_KEY=YOUR_KEY_HERE

# DS1 resource UUID — find on the dataset page at data.gov.in
# Dataset: "Year-wise details of total fish production and fisheries exports 2019-20 to 2023-24"
# Copy the UUID from the Datastore API URL shown on the dataset page.
DS1_RESOURCE_ID=REPLACE_WITH_UUID_FROM_DATAGOVIN_DS1_PAGE

# DS8 resource UUID — find on the state-wise production dataset page at data.gov.in
# Dataset: State-wise fish production figures
DS8_RESOURCE_ID=REPLACE_WITH_UUID_FROM_DATAGOVIN_DS8_PAGE

# ─── Server ────────────────────────────────────────────────────
PORT=3000
